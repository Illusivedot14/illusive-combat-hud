<div class="ich-util-dropdown ich-util-dropdown-rolls" role="menu" aria-label="{{title}}">
  <div class="ich-util-dropdown-heading">{{title}}</div>
  <label class="ich-rolls-search">
    <span class="fa-solid fa-magnifying-glass" aria-hidden="true"></span>
    <input
      type="search"
      class="ich-rolls-search-input"
      placeholder="{{searchPlaceholder}}"
      aria-label="{{searchPlaceholder}}"
      autocomplete="off"
      spellcheck="false"
    >
  </label>
  <div class="ich-rolls-tabs" role="tablist" aria-label="{{title}}">
    {{#each sections}}
    <button
      type="button"
      class="ich-rolls-tab{{#if @first}} is-active{{/if}}"
      role="tab"
      id="ich-rolls-tab-{{id}}"
      data-rolls-tab="{{id}}"
      aria-selected="{{#if @first}}true{{else}}false{{/if}}"
      aria-controls="ich-rolls-panel-{{id}}"
      tabindex="{{#if @first}}0{{else}}-1{{/if}}"
    >{{label}}</button>
    {{/each}}
  </div>
  <div class="ich-rolls-panels">
    {{#each sections}}
    <section
      class="ich-rolls-panel{{#if @first}} is-active{{/if}}"
      id="ich-rolls-panel-{{id}}"
      role="tabpanel"
      data-roll-section="{{id}}"
      aria-labelledby="ich-rolls-tab-{{id}}"
      {{#unless @first}}hidden{{/unless}}
    >
      {{#each entries}}
      <button
        type="button"
        class="ich-util-dropdown-item ich-rolls-item"
        data-roll-type="{{type}}"
        data-roll-id="{{id}}"
        data-roll-label="{{label}}"
        role="menuitem"
      >
        <span class="ich-util-dropdown-item-label">{{label}}</span>
        {{#if modLabel}}
        <span class="ich-util-dropdown-item-meta">{{modLabel}}</span>
        {{/if}}
      </button>
      {{/each}}
    </section>
    {{/each}}
  </div>
</div>
