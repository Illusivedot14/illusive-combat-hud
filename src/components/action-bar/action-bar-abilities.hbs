{{#if abilityGroups.length}}
<div class="ich-ability-groups" data-section="{{selectedSection}}">
  {{#each abilityGroups}}
  <section class="ich-ability-group{{#unless showHeader}} ich-ability-group-flat{{/unless}}" data-group-id="{{id}}">
    {{#if showHeader}}
    <div class="ich-ability-group-header">
      <span>{{label}}</span>
      {{#if spellSlots}}
      <span class="ich-spell-slot-diamonds" aria-hidden="true">
        {{#each spellSlots}}
        <span class="ich-spell-slot-gem{{#unless filled}} is-spent{{/unless}}">
          <svg class="ich-spell-slot-gem-svg" viewBox="0 0 20 20" aria-hidden="true"><polygon class="ich-spell-slot-gem-outer" points="10,1 19,10 10,19 1,10"/><polygon class="ich-spell-slot-gem-inner" points="10,6 14,10 10,14 6,10"/></svg>
        </span>
        {{/each}}
      </span>
      {{/if}}
    </div>
    {{/if}}
    <div class="ich-ability-cols" aria-hidden="true">
      <span class="ich-ability-col ich-ability-col-icon"></span>
      <span class="ich-ability-col ich-ability-col-name">{{@root.labels.colName}}</span>
      <span class="ich-ability-col ich-ability-col-range">{{@root.labels.colRange}}</span>
      <span class="ich-ability-col ich-ability-col-hit">{{@root.labels.colHit}}</span>
      <span class="ich-ability-col ich-ability-col-effect">{{@root.labels.colEffect}}</span>
      <span class="ich-ability-col ich-ability-col-notes">{{@root.labels.colNotes}}</span>
    </div>
    <div class="ich-ability-grid ich-group-grid">
      {{#each abilities}}
      <div
        class="ich-ability-btn{{#if disabled}} is-disabled{{/if}}{{#if needsTarget}} needs-target{{/if}}{{#if hasTargets}} has-target{{/if}}{{#if outOfRange}} out-of-range{{/if}}{{#if isFavorite}} is-favorite{{/if}}"
        role="button"
        tabindex="{{#if disabled}}-1{{else}}0{{/if}}"
        data-section="{{section}}"
        data-item-id="{{itemId}}"
        data-activity-id="{{activityId}}"
        data-activation-type="{{activationType}}"
        data-standard="{{isStandard}}"
        data-disabled="{{disabled}}"
        data-ability-key="{{abilityKey}}"
        data-ability-name="{{name}}"
        data-disabled-reason="{{disabledReason}}"
        aria-label="{{title}}"
      >
        <span class="ich-ability-cell ich-ability-cell-icon">
          <img class="ich-ability-img" src="{{img}}" data-fallback="icons/svg/combat.svg" alt="" width="32" height="32" loading="lazy">
          {{#if needsTarget}}
          <span class="ich-target-badge" aria-hidden="true"><i class="fas fa-crosshairs"></i></span>
          {{/if}}
        </span>
        <span class="ich-ability-cell ich-ability-cell-name">
          <span class="ich-ability-name">{{name}}</span>
          {{#if subtitle}}
          <span class="ich-ability-subtitle">{{subtitle}}</span>
          {{/if}}
        </span>
        <span class="ich-ability-cell ich-ability-cell-range">{{rangeLabel}}</span>
        <span class="ich-ability-cell ich-ability-cell-hit{{#if hitKind}} is-{{hitKind}}{{/if}}">
          {{#if hitAbility}}
          <span class="ich-ability-hit-stack">
            <span class="ich-ability-hit-ability">{{hitAbility}}</span>
            <span class="ich-ability-hit-dc">{{hitDc}}</span>
          </span>
          {{else}}
          <span class="ich-ability-hit-text">{{hitLabel}}</span>
          {{/if}}
        </span>
        <span class="ich-ability-cell ich-ability-cell-effect">{{effectLabel}}</span>
        <span class="ich-ability-cell ich-ability-cell-notes">{{notesLabel}}</span>
      </div>
      {{/each}}
    </div>
  </section>
  {{/each}}
</div>
{{else}}
<p class="ich-action-empty">{{emptyLabel}}</p>
{{/if}}
