<div class="ich-util-dropdown ich-util-dropdown-status" role="menu" aria-label="{{title}}">
  <label class="ich-token-status-search">
    <span class="fa-solid fa-magnifying-glass" aria-hidden="true"></span>
    <input
      type="search"
      class="ich-token-status-search-input"
      placeholder="{{searchPlaceholder}}"
      aria-label="{{searchPlaceholder}}"
      autocomplete="off"
      spellcheck="false"
    >
  </label>
  <div class="ich-token-status-picker" role="listbox">
    {{#each effects}}
    <button
      type="button"
      class="ich-token-status-picker-btn{{#if isActive}} is-active{{/if}}{{#if isOverlay}} is-overlay{{/if}}"
      data-status-id="{{id}}"
      data-status-name="{{title}}"
      data-ich-tip-title="{{title}}"
      aria-label="{{title}}"
      aria-pressed="{{isActive}}"
    >
      <img src="{{src}}" alt="" width="32" height="32" loading="lazy">
    </button>
    {{/each}}
  </div>
</div>
