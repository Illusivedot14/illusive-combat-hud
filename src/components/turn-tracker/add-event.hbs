{{#if recentEvents.length}}
<div class="ich-recent-events">
  {{#each recentEvents}}
  <button type="button" class="ich-recent-event" data-index="{{@index}}" data-tooltip="{{name}}" style="background-image: url('{{img}}');"></button>
  {{/each}}
</div>
{{/if}}

<div class="form-group">
  <label>{{localize "Name"}}</label>
  <div class="form-fields">
    <input type="text" name="name" value="{{prefill.name}}" required>
  </div>
</div>

<div class="form-group">
  <label>{{localize "COMBAT.CombatantInitiative"}}</label>
  <div class="form-fields">
    <input type="text" name="initiative" value="{{prefill.initiative}}" required>
  </div>
</div>

<div class="form-group">
  <label>Duration (rounds)</label>
  <div class="form-fields">
    <input type="number" name="duration" min="1" step="1" value="{{prefill.duration}}">
  </div>
</div>

<div class="form-group">
  <label>Hide Duration</label>
  <div class="form-fields">
    <input type="checkbox" name="hideDuration"{{#if prefill.hideDuration}} checked{{/if}}>
  </div>
  <p class="hint">Keep the event on the tracker without showing rounds remaining. Duration still applies for auto-expiry.</p>
</div>

<div class="form-group">
  <label>{{localize "Image"}}</label>
  <div class="form-fields">
    <file-picker type="image" name="img" value="{{prefill.img}}" placeholder="path/image.png"></file-picker>
  </div>
</div>

<div class="form-group">
  <label>{{localize "Hidden"}}</label>
  <div class="form-fields">
    <input type="checkbox" name="hidden"{{#if prefill.hidden}} checked{{/if}}>
  </div>
</div>
