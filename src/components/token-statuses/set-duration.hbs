<form class="ich-set-duration-form standard-form" autocomplete="off">
  <p class="ich-set-duration-effect">{{effectName}}</p>

  <div class="form-group">
    <label>Duration (rounds)</label>
    <div class="form-fields">
      <input type="number" name="rounds" min="1" step="1" value="{{rounds}}" required>
    </div>
  </div>
</form>
